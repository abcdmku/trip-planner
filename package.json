{
  "name": "trip-planner",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "node --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts",
    "lint": "eslint src server --ext .ts,.tsx",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "docker:prepare": "powershell -ExecutionPolicy Bypass -File scripts/docker-stage.ps1 prepare",
    "docker:build": "powershell -ExecutionPolicy Bypass -File scripts/docker-stage.ps1 build",
    "docker:up": "powershell -ExecutionPolicy Bypass -File scripts/docker-stage.ps1 up",
    "docker:config": "powershell -ExecutionPolicy Bypass -File scripts/docker-stage.ps1 config",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/trip-planner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abcdmku/trip-planner/issues"
  },
  "homepage": "https://github.com/abcdmku/trip-planner#readme",
  "description": "",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.8.2",
    "@tanstack/react-hotkeys": "^0.1.0",
    "@tanstack/react-query": "^5.90.21",
    "@vis.gl/react-google-maps": "^1.7.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "lucide-react": "^0.574.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "ws": "^8.18.3"
  },
  "type": "module"
}
